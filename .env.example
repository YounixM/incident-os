# Optional. Demo mode works with no key.
# Real agent mode uses Vercel AI Gateway. Do not put keys in client code.
AI_GATEWAY_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-4.6

# Force the deterministic demo (no LLM). Production on Vercel already defaults
# to demo because VERCEL_OIDC_TOKEN would otherwise look like an LLM is available.
# NEXT_PUBLIC_FORCE_DEMO=1
# Set NEXT_PUBLIC_FORCE_DEMO=0 to allow LLM mode even on Vercel production.
